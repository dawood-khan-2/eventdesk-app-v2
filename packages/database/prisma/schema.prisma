// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_DDL_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode = "foreignKeys"
}

model HealthCheck {
  id          String   @id @default(cuid())
  type        String   // "cron", "manual", "automated"
  createdAt   DateTime @default(now())
  
  @@map("health_checks")
}

model User {
  id                        String   @id @default(cuid())
  clerkId                   String   @unique
  email                     String   @unique
  firstName                 String?
  lastName                  String?
  imageUrl                  String?
  phone                     String?
  timezone                  String   @default("UTC")

  // Audit Fields
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  
  // Relationships
  organizationMemberships   OrganizationMember[]

  @@map("users")
  @@index([clerkId])
  @@index([email])
}

model Organization {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  name        String
  imageUrl    String?

  // Settings
  currencyCode String  @default("USD") // ISO 4217 currency code (e.g., USD, EUR, GBP)

  // Audit fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  members     OrganizationMember[]
  leads       Lead[]
  clients     Client[]
  estimates   Estimate[]
  events      Event[]
  invoices    Invoice[]

  @@map("organizations")
  @@index([clerkId])
}

model OrganizationMember {
  id            String   @id @default(cuid())
  userId        String
  orgId         String
  role          String?

  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  organization  Organization @relation(fields: [orgId], references: [id])

  @@map("organization_members")
  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
}

model Lead {
  tenantId      String
  id            String   @id @default(cuid())

  // Lead Info
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  status        LeadStatus   @default(NEW)

  // Additional Info
  notes          String?

  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  organization  Organization @relation(fields: [tenantId], references: [id])
  estimates     Estimate[]

  @@map("leads")
  @@index([tenantId])  // needed for RLS performance

}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  FOLLOW_UP
  CONVERTED
  LOST
}

model Client {
  tenantId      String
  id            String   @id @default(cuid())
  
  // Original Lead reference (optional - for history tracking)
  leadId        String?  // Reference to the original lead
  
  // Client Info (same as Lead)
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?

  // Client-specific fields
  
  
  // Additional Info
  notes          String?
  
  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  organization  Organization @relation(fields: [tenantId], references: [id])
  estimates     Estimate[]
  events        Event[]
  invoices      Invoice[]
  
  @@map("clients")
  @@index([tenantId])
}

model Estimate {
  tenantId          String
  id                String          @id @default(cuid())

  leadId            String?         // Optional reference to Lead
  clientId          String?         // Optional reference to Client
  eventId           String?         // Optional reference to Event

  title             String
  status            EstimateStatus  @default(DRAFT)
  eventName         String?
  eventVenue        String?
  eventStartDate    DateTime?
  eventEndDate      DateTime?
  expiryDate        DateTime?
  statusChangedAt   DateTime        @default(now())

  lineItems         Json            /* service category, service description, quantity, unit, tax, rate, amount */
  discount          Float?          @default(0.0)

  // Audit fields  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  organization      Organization    @relation(fields: [tenantId], references: [id])
  lead              Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client            Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  event             Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("estimates")
  @@index([tenantId])
  @@index([eventId])
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model ServiceCategories {
  tenantId      String
  id            String   @id @default(cuid())

  name          String

  @@map("service_categories")
  @@index([tenantId])
}

model Event {
  tenantId      String
  id            String   @id @default(cuid())

  clientId      String

  name          String
  venue         String?
  description   String?
  startDate     DateTime
  endDate       DateTime

  // Audit fields
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  organization    Organization  @relation(fields: [tenantId], references: [id])
  client          Client        @relation(fields: [clientId], references: [id])
  estimates       Estimate[]
  tasks           Task[]
  itineraries     Itinerary[]
  invoices        Invoice[]

  @@map("events")
  @@index([tenantId])
}

model Task {
  tenantId      String
  id            String   @id @default(cuid())
  eventId       String
  parentTaskId  String?

  title         String
  description   String?
  dueDate       DateTime?
  priority      TaskPriority    @default(MEDIUM)
  status        TaskStatus      @default(TO_DO)
  type          TaskType        @default(PRE_EVENT)

  // Audit fields
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  event         Event       @relation(fields: [eventId], references: [id])
  parentTask    Task?       @relation("TaskToSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]      @relation("TaskToSubtasks")
  checklists    Checklist[]

  @@map("tasks")
  @@index([tenantId])
  @@index([eventId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskType {
  PRE_EVENT
  ON_EVENT
  POST_EVENT
}


model Checklist{
  tenantId      String
  id            String   @id @default(cuid())
  taskId        String

  title         String
  done          Boolean    @default(false)

  // Audit fields
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  task         Task       @relation(fields: [taskId], references: [id])

  @@map("checklists")
  @@index([tenantId])
  @@index([taskId])
}

model Itinerary{
  tenantId      String
  id            String   @id @default(cuid())
  eventId       String

  title         String
  date          DateTime

  // Audit fields
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  event         Event       @relation(fields: [eventId], references: [id])

  @@map("itineraries")
  @@index([tenantId])
  @@index([eventId])
}

model Invoice {
  tenantId          String
  id                String          @id @default(cuid())

  clientId          String         // reference to Client
  eventId           String         // reference to Event

  number            String
  billTo            String
  shipTo            String?
  invoiceDate       DateTime        @default(now())
  dueDate           DateTime
  poNumber          String?         // Purchase Order Number
  paymentTerms      String?         // e.g., "Net 30", "Due on Receipt"
  notes             String?         // Any relevant information not already covered
  terms             String?         /* Terms and conditions - late fees, payment methods, delivery schedule */
  
  lineItems         Json            /* service category, service description, quantity, unit, tax, rate, amount */
  discount          Float           @default(0.0)
  amountPaid        Float           @default(0.0)
  balanceDue        Float           @default(0.0)
  status            InvoiceStatus   @default(UNPAID)

  // Audit fields  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  organization      Organization    @relation(fields: [tenantId], references: [id])
  client            Client          @relation(fields: [clientId], references: [id])
  event             Event           @relation(fields: [eventId], references: [id])

  @@map("invoices")
  @@index([tenantId])
  @@index([eventId])
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}