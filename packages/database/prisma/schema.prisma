// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_DDL_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode = "foreignKeys"
}

model HealthCheck {
  id          String   @id @default(cuid())
  type        String   // "cron", "manual", "automated"
  createdAt   DateTime @default(now())
  
  @@map("health_checks")
}

model User {
  id                        String   @id @default(cuid())
  clerkId                   String   @unique
  email                     String   @unique
  firstName                 String?
  lastName                  String?
  imageUrl                  String?
  phone                     String?
  timezone                  String   @default("UTC")

  // Audit Fields
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  
  // Relationships
  organizationMemberships   OrganizationMember[]

  @@map("users")
  @@index([clerkId])
  @@index([email])
}

model Organization {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  name        String
  imageUrl    String?

  // Audit fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  members     OrganizationMember[]
  leads       Lead[]
  clients     Client[]

  @@map("organizations")
  @@index([clerkId])
}

model OrganizationMember {
  id            String   @id @default(cuid())
  userId        String
  orgId         String
  role          String?

  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  organization  Organization @relation(fields: [orgId], references: [id])

  @@map("organization_members")
  @@unique([userId, orgId])
  @@index([userId])
  @@index([orgId])
}

model Lead {
  tenantId      String
  id            String   @id @default(cuid())

  // Lead Info
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?
  status        LeadStatus   @default(NEW)

  // Additional Info
  notes          String?

  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  organization  Organization @relation(fields: [tenantId], references: [id])

  @@map("leads")
  @@index([tenantId])  // needed for RLS performance

}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  FOLLOW_UP
  CONVERTED
  LOST
}

model Client {
  tenantId      String
  id            String   @id @default(cuid())
  
  // Original Lead reference (optional - for history tracking)
  leadId        String?  // Reference to the original lead
  
  // Client Info (same as Lead)
  name          String
  email         String?
  phone         String?
  company       String?
  address       String?

  // Client-specific fields
  
  
  // Additional Info
  notes          String?
  
  // Audit fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  organization  Organization @relation(fields: [tenantId], references: [id])
  
  @@map("clients")
  @@index([tenantId])
}
